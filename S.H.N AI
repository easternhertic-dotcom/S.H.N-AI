<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>S.H.N — Signal Terminal</title>
    
    <!-- Mobile App Configuration Window Options -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    
    <style>
        :root {
            --bg-color: #0b0f19;
            --terminal-bg: #111827;
            --text-main: #f3f4f6;
            --accent-green: #10b981;
            --border-color: #374151;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        .terminal-container {
            width: 100%;
            max-width: 800px;
            background-color: var(--terminal-bg);
            border: none;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* Desktop border rendering */
        @media (min-width: 600px) {
            .terminal-container {
                height: 92vh;
                border: 1px solid var(--border-color);
                border-radius: 8px;
            }
        }

        .terminal-header {
            background-color: #1f2937;
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .model-selector select {
            background-color: #374151;
            color: white;
            border: 1px solid var(--border-color);
            padding: 6px;
            border-radius: 4px;
            font-size: 14px;
        }

        .terminal-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            white-space: pre-wrap;
        }

        .system-msg { color: #9ca3af; font-style: italic; margin-bottom: 8px; }
        .user-msg { color: #60a5fa; margin-top: 12px; margin-bottom: 4px; }
        .shn-msg { color: var(--accent-green); margin-top: 12px; margin-bottom: 4px; }

        .setup-panel {
            background-color: #1f2937;
            padding: 12px 15px;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .setup-panel input {
            flex: 1;
            background-color: #374151;
            border: 1px solid var(--border-color);
            color: white;
            padding: 8px;
            border-radius: 4px;
            font-size: 14px;
        }

        .input-area {
            display: flex;
            align-items: center;
            padding: 12px;
            border-top: 1px solid var(--border-color);
            background-color: #1f2937;
            gap: 10px;
        }

        .input-area textarea {
            flex: 1;
            background: #2d3748;
            border: 1px solid var(--border-color);
            color: white;
            resize: none;
            outline: none;
            font-family: inherit;
            padding: 10px;
            border-radius: 6px;
            height: 24px;
            font-size: 16px; /* Prevents auto-zoom formatting glithes on iOS */
        }

        .btn {
            background-color: var(--accent-green);
            color: white;
            border: none;
            padding: 10px 18px;
            cursor: pointer;
            border-radius: 4px;
            font-weight: bold;
            font-size: 14px;
        }
        
        .btn-save {
            background-color: #4b5563;
        }
    </style>
</head>
<body>

<div class="terminal-container">
    <!-- Header -->
    <div class="terminal-header">
        <div><strong># S.H.N</strong> <span style="font-size: 11px; color: #9ca3af;">by Eastern Hertic</span></div>
        <div class="model-selector">
            <select id="modelSelect">
                <option value="llama-3.3-70b-versatile">llama-3.3-70b</option>
                <option value="llama-3.1-8b-instant">llama-3.1-8b</option>
                <option value="deepseek-r1-distill-70b">deepseek-r1-70b</option>
            </select>
        </div>
    </div>

    <!-- Chat Display -->
    <div class="terminal-body" id="terminalBody">
        <div class="system-msg">>_ No transmission yet. Paste your Groq API key under Setup, then ask S.H.N a coding question.</div>
    </div>

    <!-- API Key Setup -->
    <div class="setup-panel" id="setupPanel">
        <input type="password" id="apiKey" placeholder="Paste Groq Key (gsk_...)">
        <button class="btn btn-save" onclick="saveKey()">Save Key</button>
    </div>

    <!-- Input Bar -->
    <div class="input-area">
        <textarea id="userInput" placeholder="Ask S.H.N a question..."></textarea>
        <button class="btn" onclick="sendMessage()">Send</button>
    </div>
</div>

<script>
    // Verify stored keys on startup
    window.onload = function() {
        if(localStorage.getItem('shn_groq_key')) {
            document.getElementById('apiKey').value = localStorage.getItem('shn_groq_key');
            appendSystemMessage("Secure API Key verified from local storage session.");
        }
    }

    function saveKey() {
        const key = document.getElementById('apiKey').value.trim();
        if(!key) {
            alert("Please paste a valid key string.");
            return;
        }
        localStorage.setItem('shn_groq_key', key);
        alert("Key saved successfully to offline browser cache!");
    }

    function appendSystemMessage(text) {
        const body = document.getElementById('terminalBody');
        body.innerHTML += `<div class="system-msg">> ${text}</div>`;
        body.scrollTop = body.scrollHeight;
    }

    async function sendMessage() {
        const inputElement = document.getElementById('userInput');
        const prompt = inputElement.value.trim();
        const apiKey = localStorage.getItem('shn_groq_key');
        const selectedModel = document.getElementById('modelSelect').value;

        if(!prompt) return;
        if(!apiKey) {
            alert("Please save your Groq API key in the configuration bar first.");
            return;
        }

        const body = document.getElementById('terminalBody');
        body.innerHTML += `<div class="user-msg"><strong>You:</strong> ${prompt}</div>`;
        inputElement.value = '';

        // Added deep framework loading log
        const generatingDiv = document.createElement('div');
        generatingDiv.className = 'system-msg';
        generatingDiv.id = 'shn-loading';
        generatingDiv.textContent = '> S.H.N is processing transmission pipeline...';
        body.appendChild(generatingDiv);
        body.scrollTop = body.scrollHeight;

        try {
            // FIXED URL: Changed from public home link to official API transmission pipeline endpoint
            const response = await fetch('https://groq.com', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${apiKey}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    model: selectedModel,
                    messages: [{ role: 'user', content: prompt }]
                })
            });

            // Remove processing indicator log
            const loader = document.getElementById('shn-loading');
            if(loader) loader.remove();

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(errorData.error?.message || `HTTP Server Status: ${response.status}`);
            }

            const data = await response.json();
            const reply = data.choices[0].message.content;
            body.innerHTML += `<div class="shn-msg"><strong>S.H.N:</strong> ${reply}</div>`;
        } catch (error) {
            const loader = document.getElementById('shn-loading');
            if(loader) loader.remove();
            body.innerHTML += `<div class="system-msg" style="color: #ef4444;">> Connection Interrupted: ${error.message}. Double check key formatting or data coverage.</div>`;
        }
        body.scrollTop = body.scrollHeight;
    }

    // Capture mobile screen key adjustments
    document.getElementById('userInput').addEventListener('keydown', function(e) {
        if(e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });
</script>

</body>
</html>
